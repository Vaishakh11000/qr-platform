# Copy to .env and replace every example value before starting the services.
APP_NAME=QR Product Information Platform
APP_VERSION=1.0.0
DEBUG=false
ADMIN_TOKEN_SECRET=replace_with_output_of_openssl_rand_hex_32
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=30

PUBLIC_BASE_URL=https://products.example.com
PUBLIC_HOSTNAME=products.example.com
ADMIN_HOSTNAME=admin.example.com

POSTGRES_DB=qr_platform
POSTGRES_USER=qr_app
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
TEST_POSTGRES_DB=qr_platform_test
